# Revalidation API Token
# GitHub Webhook에서 사용할 토큰 (랜덤한 문자열로 생성하세요)
REVALIDATION_TOKEN=your-secret-token-here

# 운영 사이트 주소 (마지막 / 제외)
NEXT_PUBLIC_SITE_URL=https://blog-omega-six-74.vercel.app

# Vercel Marketplace의 Neon Postgres 연결 문자열
# Vercel에서는 Neon 연동 시 자동으로 등록됩니다.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
